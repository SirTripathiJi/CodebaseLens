{
  "name": "@tripathi_ji/codebaselens",
  "version": "1.0.0",
  "description": "Analyze project structure, languages, frameworks, dependencies, and health from the command line.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "codebaselens": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/intelligence/analyze-project.js",
    "dist/intelligence/analyze-project.d.ts",
    "dist/intelligence/configuration.js",
    "dist/intelligence/configuration.d.ts",
    "dist/intelligence/dependencies.js",
    "dist/intelligence/dependencies.d.ts",
    "dist/intelligence/frameworks.js",
    "dist/intelligence/frameworks.d.ts",
    "dist/intelligence/markers.js",
    "dist/intelligence/markers.d.ts",
    "dist/intelligence/package-manager.js",
    "dist/intelligence/package-manager.d.ts",
    "dist/intelligence/project-files.js",
    "dist/intelligence/project-files.d.ts",
    "dist/intelligence/types.js",
    "dist/intelligence/types.d.ts",
    "dist/health/insights.js",
    "dist/health/insights.d.ts",
    "dist/health/methodology.js",
    "dist/health/methodology.d.ts",
    "dist/health/project-signals.js",
    "dist/health/project-signals.d.ts",
    "dist/health/score.js",
    "dist/health/score.d.ts",
    "dist/reports/report.js",
    "dist/reports/report.d.ts",
    "dist/reports/terminal.js",
    "dist/reports/terminal.d.ts",
    "dist/scanner.js",
    "dist/scanner.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx/esm src/cli.ts",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirTripathiJi/CodebaseLens.git"
  },
  "keywords": [
    "codebase",
    "codebase-analysis",
    "project-analyzer",
    "repository-analysis",
    "developer-tools",
    "cli",
    "typescript",
    "project-health"
  ],
  "author": "SirTripathiJi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/SirTripathiJi/CodebaseLens/issues"
  },
  "homepage": "https://github.com/SirTripathiJi/CodebaseLens#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
